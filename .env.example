# =======================================================
# PhishHunter Live - Variables de Entorno
# =======================================================

# Puerto de ejecución web (Render asigna $PORT automáticamente)
PORT=8501

# Ruta del archivo de base de datos SQLite forense
DATABASE_PATH=database/phishhunter.db

# Configuración de inspección de red
HTTP_TIMEOUT=4.0
MAX_REDIRECT_HOPS=7
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 PhishHunterDefensiveCrawler/1.0

# Nivel de log (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
